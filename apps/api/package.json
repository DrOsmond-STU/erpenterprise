{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "description": "ERP Enterprise \u2014 API (NestJS + PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/seed/seed.js",
    "test:e2e": "node --env-file-if-exists=.env dist/test/e2e.js"
  },
  "dependencies": {
    "@erp/domain": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.0"
  }
}
