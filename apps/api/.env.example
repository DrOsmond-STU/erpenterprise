# Salin ke .env untuk pengembangan lokal. Jangan pernah memasukkan .env ke repositori.
NODE_ENV=development
PORT=3000
# URL peladen web yang diizinkan (CORS, cookie)
WEB_ORIGIN=http://localhost:5173

# Koneksi aplikasi: peran erp_app (tanpa BYPASSRLS)
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5432/erp
# Koneksi migrasi/seed: pemilik skema
DATABASE_ADMIN_URL=postgres://erp_owner:erp_owner_dev@localhost:5432/erp

# Minimal 32 karakter acak. Produksi: pakai kunci asimetris lewat IdP (dok. 11 K-54).
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter!!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=43200

# Kata sandi awal pengguna seed (hanya lingkungan dev/staging)
SEED_PASSWORD=Rahasia-2026!
