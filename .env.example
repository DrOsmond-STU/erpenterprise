# Salin ke .env (jangan pernah di-commit) atau set lewat unit systemd / secret manager.

NODE_ENV=production
HOST=127.0.0.1                 # dengarkan hanya di loopback; publikasikan lewat reverse proxy TLS
PORT=8080
PUBLIC_ORIGIN=https://erp.contoh.co.id
TRUST_PROXY=1                  # hanya bila berada di belakang reverse proxy tepercaya
COOKIE_SECURE=1                # wajib di produksi (HTTPS)

DB_FILE=/var/lib/erp/erp.sqlite
BACKUP_DIR=/var/backups/erp
BACKUP_RETAIN=14

# Kunci AES-256 (64 karakter heksadesimal) untuk enkripsi rahasia MFA & cadangan.
# Bangkitkan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Simpan di brankas rahasia; kehilangan kunci = cadangan tidak dapat dipulihkan.
DATA_KEY=

# Inisialisasi pertama (basis data kosong): sandi admin sementara, wajib diganti saat masuk.
ADMIN_INITIAL_PASSWORD=
SEED_DEMO=0
LOG_LEVEL=info
