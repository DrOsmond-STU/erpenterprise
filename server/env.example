# ERP Enterprise — konfigurasi produksi di hosting cPanel.
# Simpan sebagai /home/semestat/erp-config/.env (di luar document root & repositori).
# Setelah mengubah berkas ini, buat berkas kosong /home/semestat/erp-restart.request.
NODE_ENV=production
PORT=3620
WEB_ORIGIN=https://erp.semestateknologiutama.com

# Kata sandi kedua pengguna diatur di cPanel → PostgreSQL Databases → Current Users.
DATABASE_URL=postgres://semestat_erpapp:KATA_SANDI_ERPAPP@localhost:5432/semestat_erp
DATABASE_ADMIN_URL=postgres://semestat_erpowner:KATA_SANDI_ERPOWNER@localhost:5432/semestat_erp
DATABASE_APP_ROLE=semestat_erpapp

# Minimal 32 karakter acak (mis. hasil: openssl rand -base64 48).
JWT_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_KARAKTER
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=43200
