{
  "name": "@erp/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Tipe, validasi, dan aturan buku besar yang dibagi antara API dan aplikasi web",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
